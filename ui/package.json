{
  "name": "@zulkifli-dev/ui",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zulkifli-dev/zudev-kit-public.git",
    "directory": "ui"
  },
  "type": "module",
  "files": [
    "dist",
    "src/components",
    "src/styles/globals.css",
    "components.json",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./components/toast": {
      "types": "./dist/components/toast.d.ts",
      "bun": "./src/components/toast.tsx",
      "default": "./dist/components/toast.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "bun": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "bun": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles.css": "./src/styles/globals.css",
    "./components.json": "./components.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "shadcn": "^4.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
